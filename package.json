{
  "name": "github-emulator-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspaces --if-present",
    "build:playground": "npm run build --workspace apps/playground",
    "test": "npm run test:unit",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run check:actions && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --workspaces --dry-run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev",
    "build:storybook": "storybook build",
    "start": "npm run start --workspace=@moya/emulate-github",
    "docker:up": "npm run docker:up --workspace=@moya/emulate-github",
    "docker:down": "npm run docker:down --workspace=@moya/emulate-github",
    "docker:logs": "npm run docker:logs --workspace=@moya/emulate-github",
    "docker:test": "npm run docker:test --workspace=@moya/emulate-github",
    "docker:shell": "npm run docker:shell --workspace=@moya/emulate-github",
    "docker:cert": "npm run docker:cert --workspace=@moya/emulate-github",
    "test:emulator": "npm run test --workspace=@moya/emulate-github",
    "build:actions": "npm run build --workspace=@moyarich/github-emulator-actions",
    "check:actions": "npm run check:dist --workspace=@moyarich/github-emulator-actions"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.1",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@playwright/test": "^1.56.0",
    "@storybook/react-vite": "^9.1.0",
    "storybook": "^9.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  }
}
